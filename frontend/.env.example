# LiveKit
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
LIVEKIT_ROOM_NAME=mission_bay_demo_room
AGENT_NAME=agent-py

# Internal
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=

# Vision parser (Anthropic Claude Sonnet 4.6)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-6

# Moss — for /api/mission/ingest writes to the `events` index
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_API_BASE_URL=https://service.usemoss.dev/v1
MOSS_EVENTS_INDEX_NAME=events

# Shared secret between feed worker and /api/mission/ingest
MISSION_INGEST_SECRET=
