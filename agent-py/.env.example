LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TrueFoundry AI Gateway for the business-logic LLM.
# Copy these from the TrueFoundry playground's unified code snippet.
OPENAI_API_KEY=
TRUEFOUNDRY_BASE_URL=
TRUEFOUNDRY_MODEL_ID=openai-main/gpt-4o

# Moss — semantic search / memory (https://docs.moss.dev/docs)
# MOSS_PROJECT_ID / MOSS_PROJECT_KEY are filled in at index/run time (Task 9).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=knowledge
MOSS_MEMORY_INDEX_NAME=memory
MOSS_MODEL_ID=moss-minilm

# Mission Bay demo shared state written by the frontend dashboard.
MISSION_STATE_PATH=/tmp/mission-bay-world-state.json
